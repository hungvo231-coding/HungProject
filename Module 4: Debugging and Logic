// Debugging and Logic.cpp

#include <iostream>
#include <limits>

int main()
{
    int choice = 0;
    
    while (true)
    {
        std::cout << "\n--- Menu ---\n";
        std::cout << "1) Print greeting\n";
        std::cout << "2) Add two numbers\n";
        std::cout << "3) Exit\n";
        std::cout << "Enter your choice (1-3): ";

        if (!(std::cin >> choice))
        {
            std::cout << "Invalid input. Please enter a number instead of word";
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            continue;
        }

        if (choice == 1) {
            std::cout << "Hello World! \n";
        }
        else if (choice == 2) {
            double a = 0.0, b = 0.0;
            std::cout << "Enter first number: ";
            if (!(std::cin >> a))
            {
                std::cout << "Invalid number.\n";
                std::cin.clear();
                std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
                continue;
            }
            std::cout << "Enter second number: ";
            if (!(std::cin >> b))
            {
                std::cout << "Invalid number.\n";
                std::cin.clear();
                std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
                continue;
            }
            std::cout << "Sum: " << (a + b) << '\n';
        }
        else if (choice == 3) {
            std::cout << "Exiting the program.\n";
            break;
        }
        else {
            std::cout << "Choice out of range. Please select number 1 or 2 or 3.\n";
        }

    }

    return 0;
}
